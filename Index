function loanForm(id) {
  return () => {
    const loan = id ? find("loans", id) : { name: "", startBalance: "", startDate: Core.today(), rate: "", monthly: "", payDay: "", note: "" };
    if (!loan) return null;
    return { title: id ? "Изменить кредит" : "Новый кредит", key: "loanform" + (id || ""), html: `<form id="f-loan"><section class="block">
      ${fld("Кредитор *", "name", loan.name, "text", 'placeholder="Банк или человек"')}
      ${fld("Долг на начало учёта, ₽ *", "startBalance", loan.startBalance, "number")}
      ${fld("На дату", "startDate", loan.startDate, "date")}
      <div class="grid2">${fld("Ставка, % годовых", "rate", loan.rate, "number")}${fld("Платёж в месяц, ₽", "monthly", loan.monthly, "number")}</div>
      ${fld("День платежа (1–31)", "payDay", loan.payDay, "number", 'min="1" max="31" step="1" inputmode="numeric"')}
      ${fld("Заметка", "note", loan.note)}
