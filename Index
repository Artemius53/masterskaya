          touch(rec); if (!id) S.loans.push(rec);
          log("Кредит", rec.id, `${id ? "Изменён" : "Добавлен"} кредит «${rec.name}», долг ${rub(bal)}`);
          if (!id && (v.received || []).length) {
            const op = touch({ id: Core.uid(), kind: "Кредит получен", date: v.startDate || Core.today(), amount: bal, accountId: v.accountId, loanId: rec.id, note: "" });
