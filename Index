        <button class="btn danger" id="loan-del">${ic("trash")}Удалить</button>
      </div>`,
      after: l => {
        $("#loan-close", l).onclick = () => { loan.closed = !loan.closed; touch(loan); log("Кредит", id, `Кредит «${loan.name}» ${loan.closed ? "закрыт" : "открыт снова"}`); commit(); };
        $("#loan-del", l).onclick = () => {
          if (pays.length || got.length) { toast("По кредиту есть операции — удалить нельзя. Можно закрыть."); return; }
          confirmSheet("Удалить кредит?", esc(loan.name), "Удалить", () => { loan.deleted = true; touch(loan); log("Кредит", id, `Удалён кредит «${loan.name}»`); sheets.length = 0; commit(); }, true);
