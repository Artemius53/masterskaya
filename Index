  const TABLES = ["items", "batches", "clients", "subs", "orders", "lines", "payments", "plans", "accounts", "ops", "loans", "log"];
  const CALC = "расчёт: ";

  function calcColumns(table, row, D, state) {
    if (table === "items") {
      const di = D.I.get(row.id); if (!di) return {};
      return { [CALC + "себестоимость, ₽"]: di.cost, [CALC + "маржа, ₽"]: di.margin, [CALC + "осталось сделать, шт"]: di.planned, [CALC + "свободно готовых, шт"]: di.free,
        [CALC + "в резерве, шт"]: di.reserved, [CALC + "продано, шт"]: di.sold, [CALC + "не хватает под заказы, шт"]: di.shortage };
