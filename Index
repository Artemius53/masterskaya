      return { [CALC + "изделие"]: it ? it.name : "" };
    }
    if (table === "payments" || table === "plans") {
      const c = D.clientMap.get(row.clientId);
      const o = row.orderId ? state.orders.find(x => x.id === row.orderId) : null;
      const out = { [CALC + "клиент"]: c ? c.name : "", [CALC + "номер заказа"]: o ? o.no : "" };
      if (table === "payments") { const a = state.accounts.find(x => x.id === row.accountId); out[CALC + "счёт"] = a ? a.name : ""; }
      return out;
    }
    if (table === "accounts") { const x = D.B && D.B.A.get(row.id); return { [CALC + "остаток, ₽"]: x ? x.balance : "" }; }
    if (table === "ops") {
      const a = state.accounts.find(x => x.id === row.accountId), b = state.accounts.find(x => x.id === row.toAccountId), l = state.loans.find(x => x.id === row.loanId);
      return { [CALC + "счёт"]: a ? a.name : "", [CALC + "счёт зачисления"]: b ? b.name : "", [CALC + "кредит"]: l ? l.name : "" };
