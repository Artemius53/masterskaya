            const c = find("clients", e.target.value);
            if (c) { form.discount.value = c.discount || 0; form.pickup.value = c.pickup || ""; }
          }
          if (n.startsWith("l_item_")) {
            const k = n.slice(7); const it = find("items", e.target.value);
            const pf = form["l_price_" + k];
            if (it && pf && !Core.num(pf.value)) pf.value = it.price;
          }
          recalc();
        });
        $("[data-a=line-add]", l).onclick = e => { e.stopPropagation(); pull(); draft.lines.push({ itemId: "", qty: 1, price: "" }); renderSheet(); };
        l.querySelectorAll("[data-a=line-del]").forEach(b => (b.onclick = e => { e.stopPropagation(); pull(); draft.lines.splice(+b.dataset.v, 1); if (!draft.lines.length) draft.lines.push({ itemId: "", qty: 1, price: "" }); renderSheet(); }));
        recalc();
        form.onsubmit = e => {
          e.preventDefault(); pull();
          const err = $("#f-err", l);
          if (!draft.clientId) { err.textContent = "Выберите клиента."; return; }
          const good = draft.lines.filter(x => x.itemId && Math.round(Core.num(x.qty)) > 0);
          if (!good.length) { err.textContent = "Добавьте хотя бы одно изделие с количеством больше нуля."; return; }
          let rec = o;
          if (!rec) { rec = { id: Core.uid(), no: S.settings.nextOrderNo++, recognizedAt: "" }; S.orders.push(rec); }
          Object.assign(rec, { clientId: draft.clientId, date: draft.date || Core.today(), status: draft.status || "Новый", discount: Core.num(draft.discount), pickup: draft.pickup, track: draft.track, note: draft.note });
          touch(rec);
          const keep = new Set();
          good.forEach(x => {
            let line = x.id ? S.lines.find(z => z.id === x.id) : null;
            if (!line) { line = { id: Core.uid(), orderId: rec.id, costSnap: "" }; S.lines.push(line); }
            Object.assign(line, { itemId: x.itemId, qty: Math.round(Core.num(x.qty)), price: Core.num(x.price) });
            touch(line); keep.add(line.id);
          });
          S.lines.forEach(z => { if (z.orderId === rec.id && !z.deleted && !keep.has(z.id)) { z.deleted = true; touch(z); } });
          const cl = find("clients", rec.clientId);
          log("Заказ", rec.id, `${o ? "Изменён" : "Создан"} заказ №${rec.no} (${cl ? cl.name : ""}): ${good.map(x => (find("items", x.itemId) || {}).name + " ×" + Math.round(Core.num(x.qty))).join(", ")}`);
          sheets.pop(); if (!o) sheets.push(orderSheet(rec.id));
          commit();
          const d = D.O.get(rec.id);
          if (d && d.shortage && !d.order.recognizedAt) openSheet(shortageSheet(rec.id));
        };
      } };
  };
}
function shortageSheet(orderId) {
  return () => {
    const d = D.O.get(orderId); if (!d) return null;
    const need = new Map();
    d.lines.forEach(x => { const miss = x.line.qty - x.alloc; if (miss > 0) need.set(x.line.itemId, (need.get(x.line.itemId) || 0) + miss); });
    if (!need.size) return null;
    return { title: "Не хватает готовых", key: "short" + orderId, html: `<p class="hint">Для заказа №${d.order.no} свободных готовых изделий недостаточно. Запустить недостающие тиражом под этот заказ?</p>
      <section class="block">${[...need].map(([iid, n]) => { const di = D.I.get(iid); return `<div class="lineitem"><div><div class="top"><b>${esc(di ? di.item.name : "?")}</b><span class="pill red">−${n}</span></div><small>по тиражам осталось сделать ${di ? di.planned : 0} шт</small></div></div>`; }).join("")}
