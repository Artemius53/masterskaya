          const rec = b || { id: Core.uid(), itemId };
          const before = b ? `${b.qty} шт, готово ${Core.num(b.done)}${b.due ? ", к " + fdate(b.due) : ""}` : "";
          Object.assign(rec, { qty: q, done: dn, due: v.due || "", note: v.note || "" });
          touch(rec); if (!b) S.batches.push(rec);
          log("Изделие", itemId, `«${it.name}»: ${b ? `тираж изменён (${before} → ${q} шт, готово ${dn}${rec.due ? ", к " + fdate(rec.due) : ""})` : `новый тираж ${q} шт${rec.due ? " к " + fdate(rec.due) : ""}`}`);
          sheets.pop(); commit();
        };
      } };
  };
}
function readySheet(id) {
  return () => {
    const di = D.I.get(id); if (!di) return null;
    const i = di.item;
    return { title: `Готово: ${i.name}`, key: "ready" + id, html: `<form id="f-ready"><section class="block">
      ${fld("Сколько штук готово", "qty", Math.max(1, Math.min(di.planned || 1, di.batches.find(x => x.open > 0) ? di.batches.find(x => x.open > 0).open : 1)), "number", 'min="1" step="1" inputmode="numeric"')}
      ${di.planned ? `<label class="check"><input type="checkbox" name="fromPlan" value="1" checked> Засчитать в тираж (осталось сделать ${di.planned} шт, сначала ближайшие сроки)</label>` : `<p class="hint">Открытого тиража нет — штуки просто добавятся на склад.</p>`}
      </section><div id="f-err" class="err"></div>${formBtns("Добавить на склад")}</form>`,
      after: l => {
        $("#f-ready", l).onsubmit = e => {
          e.preventDefault();
          const v = formData(e.target);
          const q = Math.round(Core.num(v.qty));
          if (q < 1) { $("#f-err", l).textContent = "Количество должно быть больше нуля."; return; }
          let left = (v.fromPlan || []).length ? q : 0, closed = 0;
          di.batches.forEach(x => { if (left <= 0 || x.open <= 0) return; const take = Math.min(left, x.open); x.batch.done = Core.num(x.batch.done) + take; touch(x.batch); left -= take; closed += take; });
          i.readyTotal = Core.num(i.readyTotal) + q; touch(i);
          log("Изделие", i.id, `«${i.name}»: ${q} шт готово${closed ? `, засчитано в тираж ${closed}` : ""}`);
          sheets.pop();
          commit();
          const d2 = D.I.get(i.id);
          if (subscribersOf(i).length && d2 && d2.free > 0) openSheet(notifySheet(i.id));
        };
      } };
  };
}
