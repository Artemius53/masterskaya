</style></head><body><div id="app"></div><script>
/* ===== CORE: данные, расчёты, цепочки ===== */
const Core = (() => {
  const FORMAT_VERSION = 3;
  const STATUSES = ["Новый", "В работе", "Готов", "Отправлен", "Получен", "Отменён"];
  const CANCELLED = "Отменён";

  function uid() {
    const a = new Uint8Array(9);
    (globalThis.crypto || require("crypto").webcrypto).getRandomValues(a);
    return Array.from(a, b => (b % 36).toString(36)).join("") + Date.now().toString(36).slice(-3);
  }
  const nowIso = () => new Date().toISOString();
  function today() {
    const d = new Date();
    return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
  }
  const num = v => {
    if (v === null || v === undefined || v === "") return 0;
    if (typeof v === "number") return isFinite(v) ? v : 0;
    const n = parseFloat(String(v).replace(/\s| /g, "").replace(",", "."));
    return isFinite(n) ? n : 0;
  };
  const round2 = n => Math.round(n * 100) / 100;

  function emptyState() {
    return {
      v: FORMAT_VERSION,
      settings: {
        hourRate: 0,
        remindDays: 7,
        nextOrderNo: 1,
        lastExportAt: null,
        series: [],
        methods: ["Наличные", "Карта", "Перевод"],
        taxPct: 0,
        taxBase: "cash",
        expenseCats: ["Материалы", "Расходники", "Инструмент", "Доставка", "Реклама", "Комиссии площадок", "Налоги", "Прочее"],
        incomeCats: ["Прочий доход"]
      },
      items: [], clients: [], subs: [], orders: [], lines: [], payments: [], plans: [], log: [],
      accounts: [], ops: [], loans: [], batches: []
    };
  }

  const live = arr => arr.filter(r => !r.deleted);
  const byId = arr => { const m = new Map(); arr.forEach(r => m.set(r.id, r)); return m; };

  function itemCost(item, settings) {
    return round2(num(item.matCost) + num(item.consCost) + num(item.hours) * num(settings.hourRate));
  }

  /* --- Главный расчёт. Ничего не меняет в state. --- */
  function derive(state) {
    const s = state.settings;
    const items = live(state.items), clients = live(state.clients), orders = live(state.orders);
    const itemMap = byId(items), clientMap = byId(clients), orderMap = byId(orders);
    const lines = live(state.lines).filter(l => orderMap.has(l.orderId));
    const payments = live(state.payments), plans = live(state.plans);

    const O = new Map(); // orderId -> расчёт
    orders.forEach(o => {
      O.set(o.id, { order: o, lines: [], gross: 0, discountAmt: 0, total: 0, paid: 0, planned: 0,
        fullAlloc: false, shortage: 0, recognizable: false, cost: 0, margin: 0 });
    });
    lines.forEach(l => {
      const d = O.get(l.orderId);
      d.lines.push({ line: l, alloc: 0 });
      d.gross += num(l.qty) * num(l.price);
    });
    payments.forEach(p => {
      if (p.orderId && O.has(p.orderId)) O.get(p.orderId).paid += signed(p);
    });
    plans.forEach(p => {
      if (p.orderId && O.has(p.orderId)) O.get(p.orderId).planned += num(p.amount);
    });
    O.forEach(d => {
      d.gross = round2(d.gross);
      d.discountAmt = round2(d.gross * num(d.order.discount) / 100);
      d.total = round2(d.gross - d.discountAmt);
      d.paid = round2(d.paid);
    });

    // Распределение готовых изделий по заказам: сначала уже проданные, затем по дате создания
    const pool = new Map();
    items.forEach(i => pool.set(i.id, num(i.readyTotal)));
    const queue = orders.filter(o => o.status !== CANCELLED).sort((a, b) => {
      if (!!a.recognizedAt !== !!b.recognizedAt) return a.recognizedAt ? -1 : 1;
      const ka = a.recognizedAt || a.createdAt || "", kb = b.recognizedAt || b.createdAt || "";
      return ka < kb ? -1 : ka > kb ? 1 : 0;
    });
    queue.forEach(o => {
      const d = O.get(o.id);
      let full = d.lines.length > 0;
      d.lines.forEach(x => {
        const q = num(x.line.qty);
        const avail = Math.max(0, pool.get(x.line.itemId) || 0);
        x.alloc = Math.min(q, avail);
        pool.set(x.line.itemId, avail - x.alloc);
        if (x.alloc < q) { full = false; d.shortage += q - x.alloc; }
      });
      d.fullAlloc = full;
      d.recognizable = full && d.paid >= d.total - 0.005;
    });

    // Себестоимость и маржа
    O.forEach(d => {
      const k = d.gross > 0 ? d.total / d.gross : 0;
      let cost = 0, rev = 0;
      d.lines.forEach(x => {
        const it = itemMap.get(x.line.itemId);
        const c = d.order.recognizedAt && x.line.costSnap !== "" && x.line.costSnap != null
          ? num(x.line.costSnap) : (it ? itemCost(it, s) : 0);
        x.unitCost = c;
        cost += c * num(x.line.qty);
        rev += num(x.line.qty) * num(x.line.price) * k;
      });
      d.cost = round2(cost);
      d.margin = round2(rev - cost);
    });

    // Склад
    const I = new Map();
    items.forEach(i => I.set(i.id, { item: i, cost: itemCost(i, s), reserved: 0, sold: 0, shortage: 0, free: 0, planned: 0, batches: [], nextDue: "", overdue: false }));
    const t0 = today();
    live(state.batches || []).forEach(b => {
      const di = I.get(b.itemId); if (!di) return;
      const open = Math.max(0, Math.round(num(b.qty)) - Math.round(num(b.done)));
      di.batches.push({ batch: b, open });
      if (open > 0) {
        di.planned += open;
        if (b.due && (!di.nextDue || b.due < di.nextDue)) di.nextDue = b.due;
        if (b.due && b.due < t0) di.overdue = true;
      }
    });
    I.forEach(di => di.batches.sort((a, b) => ((a.batch.due || "9999") < (b.batch.due || "9999") ? -1 : 1)));
    O.forEach(d => {
      if (d.order.status === CANCELLED) return;
      d.lines.forEach(x => {
        const di = I.get(x.line.itemId); if (!di) return;
        if (d.order.recognizedAt) di.sold += x.alloc; else di.reserved += x.alloc;
        if (!d.order.recognizedAt) di.shortage += num(x.line.qty) - x.alloc;
      });
    });
    I.forEach(di => {
      di.free = num(di.item.readyTotal) - di.reserved - di.sold;
      di.margin = round2(num(di.item.price) - di.cost);
      di.onHand = num(di.item.readyTotal) - di.sold;
      di.totalQty = di.planned + Math.max(0, di.onHand);
    });

    // Клиенты
    const C = new Map();
    const t = today();
    clients.forEach(c => C.set(c.id, { client: c, paid: 0, debt: 0, expected: 0, overdue: 0, active: [], past: [], cancelled: [] }));
    payments.forEach(p => { const dc = C.get(p.clientId); if (dc) dc.paid += signed(p); });
    plans.forEach(p => {
      const dc = C.get(p.clientId); if (!dc) return;
      dc.expected += num(p.amount);
      if (p.date && p.date < t) dc.overdue += num(p.amount);
    });
    O.forEach(d => {
      const dc = C.get(d.order.clientId); if (!dc) return;
      if (d.order.status === CANCELLED) { dc.cancelled.push(d); return; }
      if (d.total - d.paid > 0.005) dc.debt += d.total - d.paid;
      const done = d.order.recognizedAt && d.order.status === "Получен";
      (done ? dc.past : dc.active).push(d);
    });
    C.forEach(dc => { dc.paid = round2(dc.paid); dc.debt = round2(dc.debt); dc.expected = round2(dc.expected); dc.overdue = round2(dc.overdue); });

    // Итоги
    const month = t.slice(0, 7);
    let revenueMonth = 0, marginMonth = 0, advances = 0;
    O.forEach(d => {
      if (d.order.status === CANCELLED) return;
      if (d.order.recognizedAt && d.order.recognizedAt.slice(0, 7) === month) { revenueMonth += d.total; marginMonth += d.margin; }
      if (!d.order.recognizedAt && d.paid > 0) advances += Math.min(d.paid, d.total);
    });
    let stockValue = 0;
    I.forEach(di => { if (di.free > 0) stockValue += di.free * num(di.item.price); });

    return { O, I, C, itemMap, clientMap, orderMap,
      totals: { revenueMonth: round2(revenueMonth), marginMonth: round2(marginMonth), advances: round2(advances), stockValue: round2(stockValue) } };
  }

  function signed(p) { return p.kind === "Возврат" ? -num(p.amount) : num(p.amount); }

  /* --- Переход со старых данных: счета вместо «способа оплаты» --- */
  function migrate(state) {
    const def = emptyState();
    ["accounts", "ops", "loans", "batches"].forEach(t => { if (!Array.isArray(state[t])) state[t] = []; });
    ["taxPct", "taxBase", "expenseCats", "incomeCats"].forEach(key => { if (state.settings[key] === undefined) state.settings[key] = def.settings[key]; });
    const notes = [];
    const accByName = name => state.accounts.find(a => !a.deleted && a.name.toLowerCase() === String(name).toLowerCase());
    const ensure = name => {
      let a = accByName(name);
      if (!a) { a = { id: uid(), name, opening: 0, openingDate: "", note: "", createdAt: nowIso(), updatedAt: nowIso() }; state.accounts.push(a); notes.push(`Создан счёт «${name}»`); }
      return a;
    };
    const needs = state.payments.filter(p => !p.accountId);
    if (!live(state.accounts).length) ensure("Наличные"), ensure("Карта");
    needs.forEach(p => { p.accountId = ensure(p.method || "Наличные").id; delete p.method; p.updatedAt = nowIso(); });
    if (needs.length) notes.push(`Оплатам без счёта (${needs.length}) назначен счёт по способу оплаты`);
    // Старый учёт «запланировано / в работе» → партии плана со сроком
    state.items.forEach(it => {
      // «Запланировано» — вся партия; «в работе» и готовые — её части.
      // Пример: план 20, в работе 17, готово 3 → партия 20, из неё готово 3, осталось сделать 17.
      const P = Math.round(num(it.planned)), W = Math.round(num(it.wip)), R = Math.max(0, Math.round(num(it.readyTotal)));
      const hasBatch = state.batches.some(b => b.itemId === it.id);
      if ((P > 0 || W > 0) && !hasBatch) {
        let qty, done;
        if (P >= W) { const notStarted = Math.max(0, P - W - R); qty = P; done = P - Math.min(P, W + notStarted); }
        else { qty = P + W; done = 0; } // «в работе» больше плана — значит, считались отдельно
        state.batches.push({ id: uid(), itemId: it.id, qty, done, due: it.planDate || "", note: it.planFor || "", createdAt: nowIso(), updatedAt: nowIso() });
        notes.push(`«${it.name}»: тираж ${qty} шт, из них готово ${done}, осталось сделать ${qty - done}`);
      }
      ["planned", "wip", "wipStage", "planDate", "planFor"].forEach(f => delete it[f]);
    });
    delete state.settings.stages;
    state.v = FORMAT_VERSION;
    return notes;
  }

  const OP_KINDS = ["Расход", "Доход", "Перевод", "Аванс поставщику", "Кредит получен", "Платёж по кредиту"];
  function opCashDelta(op, accountId) {
    const a = num(op.amount);
    switch (op.kind) {
      case "Доход": case "Кредит получен": return op.accountId === accountId ? a : 0;
      case "Расход": case "Аванс поставщику": case "Платёж по кредиту": return op.accountId === accountId ? -a : 0;
      case "Перевод": return (op.accountId === accountId ? -a : 0) + (op.toAccountId === accountId ? a : 0);
      default: return 0;
    }
  }
  function lastDay(y, m) { return new Date(y, m, 0).getDate(); }
  function ymd(y, m, d) { return `${y}-${String(m).padStart(2, "0")}-${String(Math.min(d, lastDay(y, m))).padStart(2, "0")}`; }
  function shiftYm(ym, delta) { let [y, m] = ym.split("-").map(Number); m += delta; while (m > 12) { m -= 12; y++; } while (m < 1) { m += 12; y--; } return `${y}-${String(m).padStart(2, "0")}`; }

  /* Бюджет: остатки, кредиты, налоги, итоги месяца. Ничего не меняет в state. */
  function budget(state, D, ym) {
    const s = state.settings, t = today();
    const accounts = live(state.accounts), ops = live(state.ops), loans = live(state.loans), payments = live(state.payments);
    const A = new Map();
    accounts.forEach(a => A.set(a.id, { account: a, balance: num(a.opening) }));
    payments.forEach(p => { const x = A.get(p.accountId); if (x) x.balance += signed(p); });
    ops.forEach(op => A.forEach((x, id) => { x.balance += opCashDelta(op, id); }));
    let cash = 0; A.forEach(x => { x.balance = round2(x.balance); cash += x.balance; });

    const L = new Map();
    loans.forEach(l => L.set(l.id, { loan: l, balance: num(l.startBalance), paidPrincipal: 0, paidInterest: 0, payments: [], lastPay: "" }));
    ops.forEach(op => {
      if (op.kind !== "Платёж по кредиту") return;
      const x = L.get(op.loanId); if (!x) return;
      x.paidPrincipal += num(op.principal); x.paidInterest += num(op.interest);
      x.payments.push(op); if ((op.date || "") > x.lastPay) x.lastPay = op.date || "";
    });
    let loanDebt = 0;
    const [ty, tm] = t.split("-").map(Number);
    L.forEach(x => {
      x.balance = round2(Math.max(0, x.balance - x.paidPrincipal));
      loanDebt += x.balance;
      const day = Math.round(num(x.loan.payDay));
      if (x.balance > 0 && day >= 1 && !x.loan.closed) {
        const thisDue = ymd(ty, tm, day);
        const paidThisMonth = x.lastPay && x.lastPay.slice(0, 7) === t.slice(0, 7);
        const nm = shiftYm(t.slice(0, 7), 1).split("-").map(Number);
        x.nextDue = paidThisMonth ? ymd(nm[0], nm[1], day) : thisDue;
        x.overdue = !paidThisMonth && thisDue < t;
      }
    });

    // Расходы, прочие доходы, поступления от клиентов по месяцам
    const expenseRows = []; // {date, category, amount, src}
    const incomeRows = [];
    ops.forEach(op => {
      if (op.kind === "Расход") expenseRows.push({ date: op.date, category: op.category || "Прочее", amount: num(op.amount), op });
      if (op.kind === "Платёж по кредиту" && num(op.interest)) expenseRows.push({ date: op.date, category: "Проценты по кредитам", amount: num(op.interest), op });
      if (op.kind === "Аванс поставщику" && op.closedAt) expenseRows.push({ date: op.closedAt, category: op.category || "Прочее", amount: num(op.amount), op });
      if (op.kind === "Доход") incomeRows.push({ date: op.date, category: op.category || "Прочий доход", amount: num(op.amount), op });
    });
    const inMonth = d => (d || "").slice(0, 7) === ym;
    const sum = (rows, f) => round2(rows.filter(f).reduce((a, r) => a + r.amount, 0));
    const byCat = {};
    expenseRows.filter(r => inMonth(r.date)).forEach(r => { byCat[r.category] = round2((byCat[r.category] || 0) + r.amount); });
    const receiptsMonth = round2(payments.filter(p => inMonth(p.date)).reduce((a, p) => a + signed(p), 0));
    let revenue = 0, margin = 0;
    D.O.forEach(d => { if (d.order.status !== CANCELLED && d.order.recognizedAt && inMonth(d.order.recognizedAt)) { revenue += d.total; margin += d.margin; } });
    const otherIncome = sum(incomeRows, r => inMonth(r.date));
    const expenses = sum(expenseRows, r => inMonth(r.date));
    let cashFlow = 0;
    payments.forEach(p => { if (inMonth(p.date) && A.has(p.accountId)) cashFlow += signed(p); });
    ops.forEach(op => { if (inMonth(op.date)) A.forEach((x, id) => { cashFlow += opCashDelta(op, id); }); });

    // Налоговый резерв: база по настройке, накопительно и за месяц
    const pct = num(s.taxPct) / 100;
    const allReceipts = payments.reduce((a, p) => a + signed(p), 0);
    let allRevenue = 0; D.O.forEach(d => { if (d.order.status !== CANCELLED && d.order.recognizedAt) allRevenue += d.total; });
    const allOther = incomeRows.reduce((a, r) => a + r.amount, 0);
    const baseAll = (s.taxBase === "revenue" ? allRevenue : allReceipts) + allOther;
    const baseMonth = (s.taxBase === "revenue" ? revenue : receiptsMonth) + otherIncome;
    const taxPaid = round2(expenseRows.filter(r => r.category === "Налоги").reduce((a, r) => a + r.amount, 0));
    const taxAccrued = round2(baseAll * pct);
    const taxReserve = round2(Math.max(0, taxAccrued - taxPaid));

    const supplierOpen = ops.filter(op => op.kind === "Аванс поставщику" && !op.closedAt);
    const supplierOpenSum = round2(supplierOpen.reduce((a, op) => a + num(op.amount), 0));
    const free = round2(cash - D.totals.advances - taxReserve);

    return { A, L, cash: round2(cash), loanDebt: round2(loanDebt), free, taxReserve, taxAccrued, taxPaid,
      supplierOpen, supplierOpenSum,
      month: { ym, revenue: round2(revenue), margin: round2(margin), otherIncome, expenses, byCat, receipts: receiptsMonth,
        profit: round2(revenue + otherIncome - expenses), cashFlow: round2(cashFlow), taxBase: round2(baseMonth), taxMonth: round2(baseMonth * pct) } };
  }

  /* --- Цепочка «оплачено + готово → списание и выручка». Меняет state, возвращает записи для журнала. --- */
  function reconcile(state) {
    const notes = [];
    for (let pass = 0; pass < 5; pass++) {
      const D = derive(state);
      let changed = false;
      D.O.forEach(d => {
        const o = d.order;
        const should = d.recognizable && o.status !== CANCELLED;
        if (should && !o.recognizedAt) {
          o.recognizedAt = today();
          o.updatedAt = nowIso();
          d.lines.forEach(x => {
            const it = D.itemMap.get(x.line.itemId);
            x.line.costSnap = it ? itemCost(it, state.settings) : 0;
            x.line.updatedAt = nowIso();
          });
          notes.push({ entity: "Заказ", entityId: o.id, text: `Заказ №${o.no}: оплачен и укомплектован — списано со склада, выручка ${d.total.toLocaleString("ru-RU")} ₽` });
          changed = true;
        } else if (!should && o.recognizedAt) {
          o.recognizedAt = "";
          o.updatedAt = nowIso();
          d.lines.forEach(x => { x.line.costSnap = ""; x.line.updatedAt = nowIso(); });
          notes.push({ entity: "Заказ", entityId: o.id, text: `Заказ №${o.no}: списание и выручка отменены (${o.status === CANCELLED ? "заказ отменён" : "оплата или остаток изменились"})` });
          changed = true;
        }
      });
      if (!changed) break;
    }
    return notes;
  }

