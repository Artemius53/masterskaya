      after: l => {
        const form = $("#f-loan", l);
        const cb = form.querySelector("input[name=received]");
        if (cb) cb.onchange = () => { $("#recv", l).hidden = !cb.checked; };
        form.onsubmit = e => {
          e.preventDefault(); const v = formData(form);
          const bal = Core.round2(Core.num(v.startBalance));
          if (!v.name) { $("#f-err", l).textContent = "Укажите кредитора."; return; }
          if (bal <= 0) { $("#f-err", l).textContent = "Укажите сумму долга."; return; }
          const day = Math.round(Core.num(v.payDay));
          if (v.payDay && (day < 1 || day > 31)) { $("#f-err", l).textContent = "День платежа — от 1 до 31."; return; }
          const rec = id ? loan : { id: Core.uid(), closed: false };
