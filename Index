<style>
:root{
  --bg:#DCE0DE; --card:#EEF0EE; --row:#F6F7F5; --chip:#E3E7E5; --ink:#0F171A; --muted:#6A7471; --line:#D2D8D5;
  --teal:#0B5A5E; --teal-ink:#0B5A5E; --on-teal:#FFFFFF;
  --money:#7A4E0A; --rust:#8A3510; --reserve-ink:#0A4A50; --red:#B0392A;
  --c-plan:#8F969A; --c-wip:#DE8B45; --c-ready:#3A9C8A; --c-res:#0A4E54; --c-sold:#A16247;
  --b-red:#F1D6D1; --b-green:#D4E7E1; --b-blue:#D8E4EA; --t-blue:#2C5C74; --b-orange:#F5E1CD; --t-orange:#94501A; --b-money:#F3E4BF; --b-grey:#E3E6E4;
  --banner:#F3DCA3; --banner-btn:#B08C3E;
  --r-card:18px; --r-ctl:12px;
  --font:"Inter", system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
  color-scheme:light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#101615; --card:#19211F; --row:#1F2826; --chip:#26302E; --ink:#E6ECEA; --muted:#98A4A0; --line:#2C3634;
    --teal:#2F8F8A; --teal-ink:#6FC4B6; --on-teal:#FFFFFF;
    --money:#D9AE5F; --rust:#E58E62; --reserve-ink:#7CC7C4; --red:#E7826F;
    --c-plan:#7F878B; --c-wip:#E39A57; --c-ready:#48B29E; --c-res:#3E8C93; --c-sold:#C07A5E;
    --b-red:#44261F; --b-green:#1D3833; --b-blue:#1F3039; --t-blue:#9CC6DA; --b-orange:#3E2C1C; --t-orange:#EDB07A; --b-money:#3A2F1B; --b-grey:#28312F;
    --banner:#3E3420; --banner-btn:#A7843A;
    color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#101615; --card:#19211F; --row:#1F2826; --chip:#26302E; --ink:#E6ECEA; --muted:#98A4A0; --line:#2C3634;
  --teal:#2F8F8A; --teal-ink:#6FC4B6; --on-teal:#FFFFFF;
  --money:#D9AE5F; --rust:#E58E62; --reserve-ink:#7CC7C4; --red:#E7826F;
  --c-plan:#7F878B; --c-wip:#E39A57; --c-ready:#48B29E; --c-res:#3E8C93; --c-sold:#C07A5E;
  --b-red:#44261F; --b-green:#1D3833; --b-blue:#1F3039; --t-blue:#9CC6DA; --b-orange:#3E2C1C; --t-orange:#EDB07A; --b-money:#3A2F1B; --b-grey:#28312F;
  --banner:#3E3420; --banner-btn:#A7843A;
  color-scheme:dark;
}
*{box-sizing:border-box}
html{font-size:14px}
html[data-size="m"]{font-size:15px}
html[data-size="l"]{font-size:16px}
body{font-size:1rem}
html,body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font);line-height:1.35;-webkit-text-size-adjust:100%}
button,input,select,textarea{font:inherit;color:inherit}
button{-webkit-tap-highlight-color:transparent}
svg.i{width:1.375rem;height:1.375rem;flex:none;stroke:currentColor;fill:none;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
.num,.money,.price{font-variant-numeric:tabular-nums}
.money{color:var(--money)}
.wrap{max-width:640px;margin:0 auto;padding:0 14px calc(7rem + env(safe-area-inset-bottom))}
header.top{padding:18px 4px 12px;display:flex;align-items:center;justify-content:space-between;gap:10px}
.hbtn{display:inline-flex;align-items:center;gap:6px;border:0;background:var(--card);color:var(--teal-ink);border-radius:999px;padding:.5rem .85rem;font-weight:600;font-size:.9rem;cursor:pointer;flex:none}
.hbtn .i{width:1.2rem;height:1.2rem}
header.top h1{min-width:0;margin:0;font-size:2.35rem;line-height:1.05;font-weight:800;letter-spacing:-.025em}

/* плашка копии */
.banner{display:flex;gap:12px;align-items:center;background:var(--banner);border-radius:var(--r-card);padding:10px 10px 10px 14px;margin-bottom:12px;font-size:.95rem;font-weight:500}
.banner span{flex:1}
.banner .btn{background:var(--banner-btn);border-color:transparent;color:#1B1407;font-weight:600;padding:9px 16px}
.banner.danger{background:var(--b-red)}

/* показатели */
.stats{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
.stat{display:flex;align-items:center;gap:10px;background:var(--card);border:0;border-radius:var(--r-card);padding:.7rem .6rem .7rem .75rem;text-align:left;min-height:4.6rem;width:100%}
button.stat{cursor:pointer}
.stat .i{width:1.75rem;height:1.75rem;color:var(--ink);stroke-width:1.6}
.stat .money-ic{color:var(--money)} .stat .teal-ic{color:var(--reserve-ink)}
.stat .t{flex:1;min-width:0}
.stat b{display:block;font-size:clamp(1.1rem,5.4vw,1.45rem);font-weight:700;line-height:1.1;letter-spacing:-.01em;white-space:nowrap}
.stat span{display:block;font-size:.84rem;color:var(--muted);margin-top:3px}
.stat .chev{width:16px;height:16px;color:var(--muted)}
.v-money{color:var(--money)} .v-teal{color:var(--reserve-ink)} .v-rust{color:var(--rust)} .v-red{color:var(--red)}
.stat span.v-red{color:var(--red)}

/* фильтры и поиск */
.seg{display:flex;flex-wrap:wrap;gap:6px;margin:0 0 12px}
.seg::-webkit-scrollbar{display:none}
.seg button{flex:none;border:0;background:var(--card);border-radius:999px;padding:9px 16px;font-size:.93rem;cursor:pointer}
.seg button[aria-pressed="true"]{background:var(--teal);color:var(--on-teal);font-weight:600}
.searchbox{position:relative;margin-bottom:14px}
.searchbox .i{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--muted)}
.search{width:100%;padding:.75rem 14px .75rem 2.9rem;border:0;border-radius:var(--r-card);background:var(--card);font-size:16px}
.search::placeholder{color:var(--muted)}

/* карточки */
.list{display:flex;flex-direction:column;gap:10px}
.card{display:grid;grid-template-columns:auto 1fr;gap:12px;width:100%;text-align:left;background:var(--card);border:0;border-radius:var(--r-card);padding:10px 12px 12px 10px;cursor:pointer}
.card.noimg{grid-template-columns:1fr}
.card .body{min-width:0}
.card .row{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.card .name{font-weight:700;font-size:1.05rem}
.card .price{white-space:nowrap;font-size:1.45rem;font-weight:700;color:var(--money);line-height:1.2;margin-top:2px}
.card .meta{color:var(--muted);font-size:.9rem;margin-top:2px}
.card .side{text-align:right;flex:none}
.card .side small{display:block;color:var(--muted);font-size:.8rem}
.card .side b{white-space:nowrap;display:block;color:var(--money);font-size:1.3rem;font-weight:700}
.card .flags{display:flex;flex-wrap:wrap;gap:6px;margin-top:10px}

/* плитка материала вместо фото */
.tile{display:flex;align-items:center;justify-content:center;border-radius:12px;color:#fff;font-weight:700;letter-spacing:.02em;text-shadow:0 1px 1px rgba(0,0,0,.25);flex:none}
.tile.s{width:3.8rem;height:3.8rem;font-size:1.1rem}
.tile.m{width:4.6rem;height:5.4rem;font-size:1.3rem;align-self:start}
.tile.l{width:6.8rem;height:6.8rem;font-size:1.9rem}
.tile.xs{width:2.8rem;height:2.8rem;font-size:.9rem;border-radius:10px}
.tile.avatar{border-radius:50%;background:var(--chip);color:var(--ink);text-shadow:none}

/* слиток */
.ingot{display:flex;gap:2px;height:13px;margin-top:12px;border-radius:7px;overflow:hidden;background:var(--chip)}
.ingot i{display:block;height:100%}
.ingot .p{background:var(--c-plan)} .ingot .w{background:var(--c-wip)} .ingot .f{background:var(--c-ready)} .ingot .r{background:var(--c-res)} .ingot .s{background:var(--c-sold)}
.counts{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;margin-top:8px}
.counts div{min-width:0}
.counts b{font-size:1.02rem;font-weight:700}
.counts small{display:block;color:var(--muted);font-size:.74rem;line-height:1.15;padding-left:14px}
.dot{display:inline-block;width:10px;height:10px;border-radius:50%;margin-right:4px;vertical-align:1px}
.d-p{background:var(--c-plan)} .d-w{background:var(--c-wip)} .d-f{background:var(--c-ready)} .d-r{background:var(--c-res)} .d-s{background:var(--c-sold)} .d-x{background:var(--red)}

/* метки */
.pill{display:inline-flex;align-items:center;gap:6px;border-radius:10px;padding:6px 10px;font-size:.88rem;white-space:nowrap;background:var(--b-grey);color:var(--ink)}
.pill .i{width:18px;height:18px}
.pill.red{background:var(--b-red);color:var(--red)} .pill.green{background:var(--b-green);color:var(--reserve-ink)}
.pill.money{background:var(--b-money);color:var(--money)} .pill.blue{background:var(--b-blue);color:var(--t-blue)} .pill.orange{background:var(--b-orange);color:var(--t-orange)}
.pill.round{border-radius:999px;padding:5px 14px}
.pill b{font-weight:700}

.fab{position:fixed;right:max(14px,calc(50% - 306px));bottom:calc(4.8rem + env(safe-area-inset-bottom));z-index:6;width:4.9rem;height:4.9rem;border:0;border-radius:50%;background:var(--teal);color:var(--on-teal);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0;font-size:.82rem;font-weight:500;box-shadow:0 8px 20px rgba(8,50,52,.3);cursor:pointer}
.fab .i{width:1.75rem;height:1.75rem;stroke-width:2}

nav.tabs{position:fixed;left:0;right:0;bottom:0;z-index:7;background:var(--card);border-top:1px solid var(--line);padding-bottom:env(safe-area-inset-bottom)}
nav.tabs .in{max-width:640px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr)}
nav.tabs button{border:0;background:none;padding:9px 4px 10px;display:flex;flex-direction:column;align-items:center;gap:3px;font-size:.8rem;color:var(--muted);cursor:pointer}
nav.tabs button .i{width:1.5rem;height:1.5rem}
nav.tabs button[aria-current="page"]{color:var(--teal-ink);font-weight:600}

.empty{padding:32px 12px;text-align:center;color:var(--muted);background:var(--card);border-radius:var(--r-card)}
.empty .btn{margin-top:12px}

/* лист */
.sheet-back{position:fixed;inset:0;z-index:20;background:rgba(8,14,13,.5);display:flex;align-items:flex-end;justify-content:center}
.sheet{background:var(--bg);width:100%;max-width:640px;max-height:92dvh;border-radius:22px 22px 0 0;display:flex;flex-direction:column}
.grab{width:40px;height:5px;border-radius:3px;background:var(--c-plan);opacity:.55;margin:8px auto 0}
.sheet-head{display:grid;grid-template-columns:90px 1fr 90px;align-items:center;padding:6px 10px 10px}
.sheet-head h2{margin:0;font-size:1.15rem;font-weight:700;text-align:center;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sheet-head .close{border:0;background:none;color:var(--teal-ink);font-weight:500;font-size:1rem;text-align:left;padding:8px 6px;cursor:pointer}
.sheet-body{overflow-y:auto;padding:4px 12px calc(20px + env(safe-area-inset-bottom))}

section.block{background:var(--card);border-radius:var(--r-card);padding:12px 14px;margin-bottom:10px}
section.block > h3{display:flex;align-items:center;gap:10px;margin:0 0 8px;font-size:1.02rem;font-weight:700}
section.block > h3 .i{width:1.4rem;height:1.4rem}
.kv{display:flex;justify-content:space-between;gap:12px;padding:4px 0;font-size:.97rem}
.kv > span:first-child{color:var(--muted)}
.kv > span:last-child{white-space:nowrap;text-align:right}
.kv.strong > span{color:var(--ink);font-weight:700}
.kv.accent > span{color:var(--money);font-weight:700;font-size:1.05rem}
.kv.sep{border-top:1px solid var(--line);margin-top:6px;padding-top:10px}
.indent{padding-left:34px}

.rowlink{display:flex;align-items:center;gap:10px;width:100%;background:var(--row);border:1px solid var(--line);border-radius:14px;padding:10px 12px;margin-top:8px;text-align:left;cursor:pointer;min-height:52px}
.rowlink .l{flex:1;min-width:0}
.rowlink .l small{display:block;color:var(--muted);font-size:.84rem}
.rowlink .l b{font-weight:600}
.rowlink .chev{width:16px;height:16px;color:var(--muted)}
.rowlink.plain{cursor:default}
.withtile{display:grid;grid-template-columns:auto 1fr;gap:10px;align-items:center;margin-top:8px}
.withtile .rowlink{margin-top:0}
.tel{display:inline-flex;align-items:center;gap:6px;color:var(--teal-ink);text-decoration:none;font-weight:500;white-space:nowrap}
.tel .i{width:20px;height:20px}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid var(--line);background:var(--row);border-radius:var(--r-ctl);padding:.7rem .85rem;cursor:pointer;font-weight:500;font-size:.98rem;min-height:44px}
.btn .i{width:1.3rem;height:1.3rem}
.btn.primary{background:var(--teal);border-color:var(--teal);color:var(--on-teal)}
.btn.outline{background:transparent;border-color:var(--teal);color:var(--teal-ink)}
.btn.danger{background:transparent;border-color:var(--red);color:var(--red)}
.btn.ghost{border-color:transparent;background:transparent;color:var(--muted)}
.btn.small{padding:7px 12px;min-height:38px;font-size:.9rem;gap:6px}
.btn.small .i{width:18px;height:18px}
.btn.textred{border:0;background:none;color:var(--red);min-height:38px;padding:6px 4px;font-size:.92rem;gap:6px}
.btn.textred .i{width:20px;height:20px}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btns{display:flex;flex-wrap:wrap;gap:8px;margin:10px 0 0}
.btns > .btn{flex:1 1 0}
.btns.g2{display:grid;grid-template-columns:1fr 1fr}
.btns.g3{display:grid;grid-template-columns:repeat(3,1fr)}
.btns.g3 .btn{padding:10px 6px;font-size:.86rem;gap:5px;line-height:1.15}
.btns.g3 .btn .i{width:20px;height:20px}
.btns.bottom{margin:14px 0 4px}
:focus-visible{outline:2px solid var(--teal-ink);outline-offset:2px}

/* строки оплат */
.payrow{display:flex;align-items:center;gap:10px;background:var(--row);border:1px solid var(--line);border-radius:14px;padding:8px 8px 8px 14px;margin-top:8px}
.payrow b{font-size:1.05rem;white-space:nowrap}
.payrow .l{flex:1;min-width:0;color:var(--muted);font-size:.84rem;display:flex;flex-direction:column;gap:1px}
.payrow .l span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.payrow .acts{display:flex;align-items:center;gap:6px;border-left:1px solid var(--line);padding-left:8px}
.btn.got{background:var(--teal);color:var(--on-teal);border-color:var(--teal);min-height:36px;padding:6px 10px;font-size:.9rem;gap:6px}
.btn.got .i{width:18px;height:18px}

/* верх карточки изделия */
.hero{margin:2px 4px 12px}
.hero .price{font-size:2rem;font-weight:700;color:var(--money);line-height:1.1}
.hero .meta{color:var(--muted);margin-top:4px}
.hero .mg{margin-top:8px;color:var(--muted);font-size:.9rem}
.hero .mg b{color:var(--money);font-size:1.35rem;font-weight:700;margin-left:4px}
.legend{display:grid;grid-template-columns:1fr 1fr;gap:4px 18px;margin-top:10px;font-size:.9rem}
.legend .col > div{display:flex;justify-content:space-between;align-items:baseline;gap:6px}
.legend > div span{color:var(--ink)}
.legend b{font-weight:700}
.legend .col{display:flex;flex-direction:column;gap:5px}
.legend .col + .col{border-left:1px solid var(--line);padding-left:14px}
.inforow{display:flex;align-items:center;gap:10px;background:var(--chip);border-radius:12px;padding:11px 12px;margin-top:10px;width:100%;border:0;text-align:left;cursor:pointer;font-size:.98rem}
.inforow span{flex:1}

.chips{display:flex;gap:6px;overflow-x:auto;scrollbar-width:none;margin:0 -4px;padding:0 4px}
.chips::-webkit-scrollbar{display:none}
.chips button{flex:none;border:0;background:var(--chip);border-radius:12px;padding:9px 13px;font-size:.92rem;cursor:pointer}
.chips button[aria-pressed="true"]{background:var(--teal);color:var(--on-teal)}
.chips button:disabled{opacity:.5}

.lineitem{display:block;margin-top:8px}
.lineitem .top{display:flex;justify-content:space-between;gap:10px}
.lineitem .top b{font-weight:600}
.lineitem small{color:var(--muted);display:block}
.lineitem .flags{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}

.client-head{display:grid;grid-template-columns:auto 1fr;gap:14px;align-items:start}
.client-head .tile{width:5.2rem;height:5.2rem}
.client-head .tile .i{width:2.4rem;height:2.4rem}
.ctable{display:grid;grid-template-columns:auto 1fr;gap:6px 12px;font-size:.95rem}
.ctable > span:nth-child(odd){color:var(--muted)}

/* формы */
label.f{display:block;margin-bottom:10px;font-size:.88rem;color:var(--muted)}
label.f{min-width:0}
label.f input,label.f select,label.f textarea{display:block;width:100%;max-width:100%;min-width:0;margin-top:5px;padding:0 .8rem;border:1px solid var(--line);border-radius:var(--r-ctl);background:var(--row);color:var(--ink);font-size:16px;line-height:1.2}
label.f input,label.f select{height:46px}
label.f textarea{padding:.65rem .8rem}
label.f input[type="date"]{-webkit-appearance:none;appearance:none;text-align:left;display:flex;align-items:center}
label.f input[type="date"]::-webkit-date-and-time-value{text-align:left;margin:0}
label.f input[type="date"]::-webkit-calendar-picker-indicator{margin-left:auto}
label.f select{-webkit-appearance:none;appearance:none;padding-right:2.2rem;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%238F969A' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><path d='m7 10 5 5 5-5'/></svg>");background-repeat:no-repeat;background-position:right .7rem center;background-size:18px}
label.f textarea{min-height:110px;resize:vertical;line-height:1.45}
.grid2{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:0 10px;align-items:end}
.grid2 > *{min-width:0}
.grid3{display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1fr) auto;gap:0 8px;align-items:end}
.grid3 > *{min-width:0}
.grid3 label.f:first-child{grid-column:1/-1}
.hint{font-size:.86rem;color:var(--muted);margin:6px 0 10px}
.check{display:flex;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line);font-size:.97rem}
.check input{width:20px;height:20px;accent-color:var(--teal)}
.err{color:var(--red);font-size:.9rem;margin:4px 0}
.linebox{background:var(--row);border:1px solid var(--line);border-radius:14px;padding:10px 10px 0;margin-bottom:8px}
.sect-title{font-size:1rem;font-weight:700;margin:14px 0 8px}

/* журнал */
.logrow{display:grid;grid-template-columns:5.6rem auto 1fr;gap:10px;align-items:center;background:var(--row);border:1px solid var(--line);border-radius:14px;padding:10px 12px;margin-top:8px;font-size:.92rem}
.logrow time{color:var(--muted);font-size:.8rem;line-height:1.3}
.logrow .ico{width:2.4rem;height:2.4rem;border-radius:50%;display:flex;align-items:center;justify-content:center;background:var(--b-green);color:var(--reserve-ink)}
.logrow .ico.money{background:var(--b-money);color:var(--money)}
