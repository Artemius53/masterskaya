  if (q) list = list.filter(di => [di.item.name, di.item.series, di.item.material, di.item.coating].join(" ").toLowerCase().includes(q));
  list.sort((a, b) => a.item.name.localeCompare(b.item.name, "ru"));
  if (list.length) return list.map(stockCard).join("");
  if (!S.items.some(i => !i.deleted)) return `<div class="empty">Склад пуст. Добавьте первое изделие: количество, срок и стоимость вводятся сразу.<br><button class="btn primary" data-a="item-form">${ic("plus")}Добавить изделие</button></div>`;
