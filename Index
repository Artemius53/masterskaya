      </section>
      <section class="block"><h3>${ic("doc")}Платежи</h3>
        ${pays.map(op => `<div class="payrow"><b class="num">${rub(op.amount)}</b><span class="l"><span>${fdate(op.date)} · ${esc(accName(op.accountId))}</span><span>тело ${rub(op.principal)}, проценты ${rub(op.interest)}</span></span><button class="btn small" data-a="loan-pay" data-id="${id}" data-op="${op.id}" aria-label="Изменить">${ic("pencil")}</button></div>`).join("") || `<p class="hint indent">Платежей нет.</p>`}
