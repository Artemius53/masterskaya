function loanPayForm(loanId, opId) {
  return () => {
    const loan = find("loans", loanId); if (!loan) return null;
    const op = opId ? find("ops", opId) : null;
    const B = Core.budget(S, D, view.ym);
    const x = B.L.get(loanId);
    const est = Core.round2((x.balance + (op ? Core.num(op.principal) : 0)) * Core.num(loan.rate) / 100 / 12);
    const amount = op ? op.amount : loan.monthly;
    const interest = op ? op.interest : "";
    return { title: `${op ? "Изменить платёж" : "Платёж"}: ${loan.name}`, key: "lpay" + loanId + (opId || ""), html: `<form id="f-lpay"><section class="block">
      ${fld("Сумма платежа, ₽ *", "amount", amount, "number")}
      ${fld("Дата", "date", op ? op.date : Core.today(), "date")}
      <div class="grid2">${fld("Из них проценты, ₽", "interest", interest, "number")}<label class="f">Основной долг, ₽<input id="lp-principal" value="" disabled></label></div>
      <p class="hint">Проценты возьмите из графика или выписки банка.${Core.num(loan.rate) ? ` Грубая оценка по остатку и ставке: ${rub(est)} — это не расчёт банка.` : ""}</p>
      ${accountSelect("accountId", "Со счёта", op ? op.accountId : "")}
      ${fld("Заметка", "note", op ? op.note : "")}
      </section><div id="f-err" class="err"></div>
      ${op ? `<div class="btns"><button type="button" class="btn danger" id="lp-del">${ic("trash")}Удалить платёж</button></div>` : ""}
      ${formBtns()}</form>`,
      after: l => {
        const form = $("#f-lpay", l);
        const upd = () => { const a = Core.num(form.amount.value), i = Core.num(form.interest.value); $("#lp-principal", l).value = nf.format(Core.round2(a - i)); };
        form.addEventListener("input", upd); upd();
        const del = $("#lp-del", l);
        if (del) del.onclick = () => confirmSheet("Удалить платёж?", `${rub(op.amount)} от ${fdate(op.date)}. Остаток долга и остаток счёта пересчитаются.`, "Удалить", () => {
          op.deleted = true; touch(op); log("Кредит", loanId, `Удалён платёж по кредиту «${loan.name}»: ${rub(op.amount)}`); sheets.pop(); commit();
        }, true);
        form.onsubmit = e => {
          e.preventDefault(); const v = formData(form);
          const amt = Core.round2(Core.num(v.amount)), intr = Core.round2(Core.num(v.interest));
          const err = $("#f-err", l);
          if (amt <= 0) { err.textContent = "Сумма должна быть больше нуля."; return; }
          if (intr < 0 || intr > amt) { err.textContent = "Проценты — от нуля до суммы платежа."; return; }
          if (!v.accountId) { err.textContent = "Выберите счёт."; return; }
          const rec = op || { id: Core.uid(), kind: "Платёж по кредиту", loanId };
          Object.assign(rec, { date: v.date || Core.today(), amount: amt, interest: intr, principal: Core.round2(amt - intr), accountId: v.accountId, note: v.note, category: "" });
          touch(rec); if (!op) S.ops.push(rec);
          log("Кредит", loanId, `${op ? "Изменён платёж" : "Платёж"} по кредиту «${loan.name}»: ${rub(amt)} (тело ${rub(rec.principal)}, проценты ${rub(intr)})`);
          sheets.pop(); commit();
        };
      } };
  };
}

