    if (c) return false;
    if (f === "done") return orderDone(d);
    if (f === "short") return d.shortage > 0 && !d.order.recognizedAt;
    if (f === "debt") return d.total - d.paid > 0.005;
    return !orderDone(d);
  });
  if (q) list = list.filter(d => {
    const c = D.clientMap.get(d.order.clientId);
    const names = d.lines.map(x => (D.itemMap.get(x.line.itemId) || {}).name || "").join(" ");
    return String(d.order.no) === q || [c ? c.name : "", names, d.order.track].join(" ").toLowerCase().includes(q);
  });
  list.sort((a, b) => b.order.no - a.order.no);
  if (list.length) return list.map(orderCard).join("");
  if (!S.orders.some(o => !o.deleted)) return `<div class="empty">Заказов пока нет. Заказ связывает клиента, изделия и оплаты.<br><button class="btn primary" data-a="order-form">${ic("plus")}Создать заказ</button></div>`;
