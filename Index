  const sheetsData = Core.toSheets(S);
  const wb = XLSX.utils.book_new();
  sheetsData.forEach(sh => {
    const ws = XLSX.utils.aoa_to_sheet(sh.rows);
    ws["!cols"] = (sh.rows[0] || []).map((_, ci) => ({ wch: Math.min(40, Math.max(8, ...sh.rows.slice(0, 200).map(r => String(r[ci] ?? "").length))) }));
    XLSX.utils.book_append_sheet(wb, ws, sh.name.slice(0, 31));
  });
  const buf = XLSX.write(wb, { bookType: "xlsx", type: "array" });
  const stamp = new Date(); const pad = n => String(n).padStart(2, "0");
  const filename = `Мастерская копия ${stamp.getFullYear()}-${pad(stamp.getMonth() + 1)}-${pad(stamp.getDate())} ${pad(stamp.getHours())}-${pad(stamp.getMinutes())}.xlsx`;
  const dl = await getDownloads();
  let ok = false;
  if (dl) {
    try { const r = await dl.save({ filename, data: new Blob([buf]) }); ok = r && r.status === "saved"; }
    catch (e) {
      const code = e && e.code;
      if (code === "declined") toast("Сохранение отменено.");
      else if (code === "rate_limited") toast("Окно сохранения уже открыто.");
      else toast("Не удалось сохранить файл" + (code ? ` (${code})` : "") + ".");
      return false;
    }
  } else {
    const mime = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
    const touch = window.matchMedia && matchMedia("(pointer: coarse)").matches;
    if (touch && typeof File === "function" && navigator.canShare) {
      try {
        const file = new File([buf], filename, { type: mime });
        if (navigator.canShare({ files: [file] })) {
          await navigator.share({ files: [file], title: filename });
          ok = true;
        }
      } catch (e) {
        if (e && e.name === "AbortError") { toast("Сохранение отменено."); return false; }
      }
    }
    if (!ok) try {
      const url = URL.createObjectURL(new Blob([buf], { type: mime }));
      const a = document.createElement("a"); a.href = url; a.download = filename; document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 5000);
      ok = true;
    } catch (e) { toast("Сохранение файлов в этом окне недоступно."); return false; }
  }
  if (ok) {
    S.settings.lastExportAt = Core.nowIso();
    log("Копия", "", `Выгружена копия: ${filename}`);
    save(); D = Core.derive(S); render();
    toast("Копия сохранена");
  }
  return ok;
}
function doImportPick() {
  const inp = $("#file-in");
  if (!inp) return;
  inp.value = "";
  inp.onchange = async () => {
    const file = inp.files && inp.files[0]; if (!file) return;
    if (!window.XLSX) { toast("Модуль Excel не загрузился. Проверьте интернет."); return; }
    try {
      const buf = await file.arrayBuffer();
      const wb = XLSX.read(buf, { type: "array", cellDates: true });
      const book = {};
      wb.SheetNames.forEach(n => { book[n.trim()] = XLSX.utils.sheet_to_json(wb.Sheets[n], { header: 1, defval: "", raw: true, blankrows: false }); });
      openSheet(importSheet(Core.fromSheets(book), file.name));
    } catch (e) { console.error(e); toast("Не удалось прочитать файл. Нужен .xlsx, выгруженный из приложения."); }
  };
  inp.click();
}
function importSheet(res, name) {
  return () => ({ title: "Загрузка из Excel", key: "import", html: `
    <p class="hint">Файл: ${esc(name)}</p>
    <section class="block"><h3>${ic("excel")}Что в файле</h3>${Object.entries(res.counts).map(([k, v]) => `<div class="kv"><span>${esc(k)}</span><span class="num">${v}</span></div>`).join("")}</section>
    ${res.errors.length ? `<section class="block"><h3 style="color:var(--red)">${ic("warn")}Ошибки — загрузка невозможна (${res.errors.length})</h3>${res.errors.slice(0, 50).map(x => `<p class="err">${esc(x)}</p>`).join("")}${res.errors.length > 50 ? `<p class="hint">…и ещё ${res.errors.length - 50}</p>` : ""}<p class="hint">Исправьте файл на компьютере и загрузите снова.</p></section>` : ""}
    ${res.warnings.length ? `<section class="block"><h3>Предупреждения</h3>${res.warnings.map(x => `<p class="hint">${esc(x)}</p>`).join("")}</section>` : ""}
    ${res.errors.length ? `<div class="btns"><button class="btn" data-a="close">Закрыть</button></div>` : `
      <section class="block"><p style="margin:0">Текущие данные в приложении будут полностью заменены содержимым файла.</p></section>
      <div class="btns g2"><button class="btn" id="imp-export">${ic("upload")}Сначала выгрузить текущие</button><button class="btn danger" id="imp-go">Заменить данные</button></div>`}`,
    after: l => {
      const ex = $("#imp-export", l); if (ex) ex.onclick = () => doExport();
      const go = $("#imp-go", l);
      if (go) go.onclick = () => {
        S = res.state;
        log("Копия", "", `Данные заменены из файла ${name}`);
        sheets.length = 0;
        commit();
        toast("Данные загружены");
      };
    } });
}

/* ---------- События ---------- */
document.addEventListener("click", e => {
  const el = e.target.closest("[data-a]"); if (!el) return;
  const a = el.dataset.a, id = el.dataset.id, v = el.dataset.v;
  if (a === "backdrop") { if (e.target === el) closeSheet(); return; }
  switch (a) {
    case "tab": view.tab = v; sheets.length = 0; window.scrollTo(0, 0); render(); break;
    case "close": closeSheet(); break;
    case "stock-filter": view.stockFilter = v; render(); break;
    case "order-filter": view.orderFilter = v; render(); break;
    case "series": sheets.length = 0; view.tab = "stock"; view.stockFilter = "all"; view.q = v; window.scrollTo(0, 0); render(); break;
    case "item": openSheet(itemSheet(id)); break;
    case "item-form": openSheet(itemForm(id)); break;
    case "ready": openSheet(readySheet(id)); break;
    case "batch-form": openSheet(batchForm(el.dataset.item, id)); break;
    case "calendar": openSheet(calendarSheet()); break;
    case "item-del": {
      const inUse = Core.live(S.lines).some(l => l.itemId === id && find("orders", l.orderId));
      if (inUse) { toast("Изделие есть в заказах — удалить нельзя. Сначала уберите его из заказов."); break; }
      const it = find("items", id);
      confirmSheet("Удалить изделие?", `«${esc(it.name)}» пропадёт со склада. В выгрузке Excel запись останется с пометкой «Удалено».`, "Удалить", () => {
        it.deleted = true; touch(it);
        Core.live(S.subs).forEach(s => { if (s.kind === "изделие" && s.ref === id) { s.deleted = true; touch(s); } });
        log("Изделие", id, `Удалено изделие «${it.name}»`); sheets.length = 0; commit();
      }, true);
      break;
    }
    case "order": openSheet(orderSheet(id)); break;
    case "order-form": openSheet(orderForm(id, el.dataset.client)); break;
    case "order-status": {
      const o = find("orders", id); if (!o || o.status === v) break;
      const before = o.status; o.status = v; touch(o);
      log("Заказ", id, `Заказ №${o.no}: статус «${before}» → «${v}»`); commit(); break;
    }
    case "order-cancel": openSheet(cancelSheet(id)); break;
    case "order-restore": {
      const o = find("orders", id); o.status = "Новый"; touch(o);
      log("Заказ", id, `Заказ №${o.no} возвращён в работу`); commit(); break;
    }
    case "order-del": {
      const o = find("orders", id);
      if (Core.live(S.payments).some(p => p.orderId === id)) { toast("По заказу есть оплаты. Удалите оплаты или отмените заказ."); break; }
      confirmSheet(`Удалить заказ №${o.no}?`, "Заказ, его строки и ожидаемые оплаты будут удалены. Для истории лучше «Отменить заказ».", "Удалить", () => {
        o.deleted = true; touch(o);
        S.lines.forEach(l => { if (l.orderId === id && !l.deleted) { l.deleted = true; touch(l); } });
        S.plans.forEach(p => { if (p.orderId === id && !p.deleted) { p.deleted = true; touch(p); } });
        log("Заказ", id, `Удалён заказ №${o.no}`); sheets.length = 0; commit();
      }, true);
      break;
    }
    case "plan-shortage": openSheet(shortageSheet(id)); break;
    case "pay-form": openSheet(payForm(el.dataset.client, el.dataset.order)); break;
    case "plan-form": openSheet(planForm(el.dataset.client, el.dataset.order)); break;
    case "pay-del": {
      const p = find("payments", id);
      confirmSheet("Удалить оплату?", `${esc(p.kind)} ${rub(p.amount)} от ${fdate(p.date)}. Склад, выручка и долг пересчитаются.`, "Удалить", () => {
        p.deleted = true; touch(p); const c = find("clients", p.clientId);
        log("Оплата", id, `Удалена оплата ${rub(p.amount)} (${c ? c.name : ""})`); commit();
      }, true);
      break;
    }
    case "plan-got": { const p = find("plans", id); openSheet(payForm(p.clientId, p.orderId, { fromPlan: id, amount: p.amount, orderId: p.orderId, note: p.note })); break; }
    case "plan-del": {
      const p = find("plans", id);
      confirmSheet("Удалить ожидаемую оплату?", `${rub(p.amount)}${p.date ? " к " + fdate(p.date) : ""}.`, "Удалить", () => {
        p.deleted = true; touch(p); log("Ожидаемая оплата", id, `Удалена ожидаемая оплата ${rub(p.amount)}`); commit();
      }, true);
      break;
    }
    case "client": openSheet(clientSheet(id)); break;
    case "client-form": openSheet(clientForm(id)); break;
    case "subs-form": openSheet(subsForm(id)); break;
    case "client-del": {
      const c = find("clients", id);
      if (Core.live(S.orders).some(o => o.clientId === id) || Core.live(S.payments).some(p => p.clientId === id)) { toast("У клиента есть заказы или оплаты — удалить нельзя."); break; }
      confirmSheet("Удалить клиента?", esc(c.name), "Удалить", () => {
        c.deleted = true; touch(c);
        S.subs.forEach(s => { if (s.clientId === id && !s.deleted) { s.deleted = true; touch(s); } });
        S.plans.forEach(p => { if (p.clientId === id && !p.deleted) { p.deleted = true; touch(p); } });
        log("Клиент", id, `Удалён клиент ${c.name}`); sheets.length = 0; commit();
      }, true);
      break;
    }
    case "size": applySize(v); render(); break;
    case "btab": view.btab = v; render(); break;
    case "ym": view.ym = Core.shiftYm(view.ym, +v); render(); break;
    case "op-filter": view.opFilter = v; render(); break;
    case "op-form": openSheet(opForm(id, v)); break;
    case "op": openSheet(opSheet(id)); break;
    case "account": openSheet(accountSheet(id)); break;
    case "account-form": openSheet(accountForm(id)); break;
    case "loan": openSheet(loanSheet(id)); break;
    case "loan-form": openSheet(loanForm(id)); break;
    case "loan-pay": openSheet(loanPayForm(id, el.dataset.op)); break;
    case "install-help": openSheet(installSheet()); break;
    case "export": doExport(); break;
    case "import": doImportPick(); break;
    case "wipe":
      confirmSheet("Стереть все данные?", "Склад, клиенты, заказы, оплаты и журнал будут удалены с этого телефона. Отменить нельзя. Сначала выгрузите копию.", "Стереть", () => {
        S = Core.emptyState(); Core.migrate(S); sheets.length = 0; save(); D = Core.derive(S); render(); toast("Данные стёрты");
      }, true);
      break;
  }
});
document.addEventListener("input", e => {
  const k = e.target.dataset && e.target.dataset.in;
  if (!k) return;
  view[k] = e.target.value;
  const box = document.getElementById("list-" + k);
  if (box) box.innerHTML = k === "q" ? stockList() : k === "oq" ? orderList() : clientList();
});
document.addEventListener("submit", e => {
  if (e.target.id !== "f-settings") return;
  e.preventDefault();
  const v = formData(e.target);
  const lines = x => x.split("\n").map(s => s.trim()).filter(Boolean);
  const st = S.settings;
  const changes = [];
  if (Core.num(v.hourRate) !== Core.num(st.hourRate)) changes.push(`ставка часа ${st.hourRate} → ${Core.num(v.hourRate)}`);
  st.hourRate = Core.num(v.hourRate);
  st.remindDays = Math.max(1, Math.round(Core.num(v.remindDays)) || 7);
  st.series = lines(v.series);
  const ec = lines(v.expenseCats); if (ec.length) st.expenseCats = ec;
  const icx = lines(v.incomeCats); if (icx.length) st.incomeCats = icx;
  const tp = Core.num(v.taxPct); if (tp !== Core.num(st.taxPct)) changes.push(`налог ${st.taxPct}% → ${tp}%`);
  st.taxPct = Math.max(0, Math.min(100, tp)); st.taxBase = v.taxBase === "revenue" ? "revenue" : "cash";
  log("Настройки", "", "Настройки сохранены" + (changes.length ? ": " + changes.join(", ") : ""));
  commit(); toast("Настройки сохранены");
});
document.addEventListener("keydown", e => { if (e.key === "Escape" && sheets.length) closeSheet(); });

/* ---------- Старт ---------- */
S = load();
const migNotes = Core.migrate(S);
migNotes.forEach(n => log("Бюджет", "", n));
if (migNotes.length) save();
const startNotes = Core.reconcile(S);
if (startNotes.length) { startNotes.forEach(n => log(n.entity, n.entityId, n.text)); save(); }
D = Core.derive(S);
render();
if (window.claude && typeof window.claude.use === "function") getDownloads();
try { if (navigator.storage && navigator.storage.persist) navigator.storage.persist(); } catch (e) {}
if ("serviceWorker" in navigator && (location.protocol === "https:" || location.hostname === "localhost") && !window.claude) {
  window.addEventListener("load", () => navigator.serviceWorker.register("sw.js").catch(() => {}));
}
})();
</script></body></html>
