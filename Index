/* ===================== КАЛЕНДАРЬ ===================== */
function calendarEvents(ym) {
  const t = Core.today(), ev = [];
  D.I.forEach(di => di.batches.forEach(x => {
    if (x.open > 0 && x.batch.due && x.batch.due.slice(0, 7) === ym)
      ev.push({ date: x.batch.due, kind: "plan", title: `Срок: ${di.item.name}`, sub: `осталось ${x.open} из ${x.batch.qty} шт${x.batch.note ? " · " + x.batch.note : ""}`, late: x.batch.due < t, act: `data-a="item" data-id="${di.item.id}"` });
  }));
  Core.live(S.plans).forEach(p => {
    if (p.date && p.date.slice(0, 7) === ym) { const c = D.clientMap.get(p.clientId); ev.push({ date: p.date, kind: "money", title: `Ожидается оплата: ${c ? c.name : ""}`, sub: rub(p.amount), late: p.date < t, act: `data-a="client" data-id="${p.clientId}"` }); }
  });
  const B = Core.budget(S, D, ym);
  const [y, m] = ym.split("-").map(Number);
  B.L.forEach(x => {
    const l = x.loan, day = Math.round(Core.num(l.payDay));
    x.payments.forEach(op => { if ((op.date || "").slice(0, 7) === ym) ev.push({ date: op.date, kind: "loan", title: `Платёж внесён: ${l.name}`, sub: rub(op.amount), late: false, act: `data-a="loan" data-id="${l.id}"` }); });
    if (l.closed || x.balance <= 0 || day < 1) return;
    const due = `${ym}-${String(Math.min(day, new Date(y, m, 0).getDate())).padStart(2, "0")}`;
    const paidThisMonth = x.payments.some(op => (op.date || "").slice(0, 7) === ym);
    if (ym >= t.slice(0, 7) && !paidThisMonth) ev.push({ date: due, kind: "loan", title: `Платёж по кредиту: ${l.name}`, sub: rub(l.monthly), late: due < t, act: `data-a="loan" data-id="${l.id}"` });
  });
  return ev.sort((a, b) => (a.date < b.date ? -1 : a.date > b.date ? 1 : 0));
}
function calendarSheet() {
  let ym = Core.today().slice(0, 7), selDay = "";
  return () => {
    const ev = calendarEvents(ym);
    const [y, m] = ym.split("-").map(Number);
    const first = new Date(y, m - 1, 1), days = new Date(y, m, 0).getDate();
    const lead = (first.getDay() + 6) % 7;
    const t = Core.today();
    const cells = [];
    for (let k = 0; k < lead; k++) cells.push(`<span class="cd empty"></span>`);
    for (let d = 1; d <= days; d++) {
      const ds = `${ym}-${String(d).padStart(2, "0")}`;
      const de = ev.filter(e => e.date === ds);
      const kinds = [...new Set(de.map(e => e.kind))];
      const late = de.some(e => e.late);
      cells.push(`<button type="button" class="cd${ds === t ? " today" : ""}${ds === selDay ? " sel" : ""}" data-day="${ds}" aria-label="${d}, событий: ${de.length}"><span>${d}</span><span class="dots">${kinds.map(k => `<i class="k-${late && k === "plan" ? "late" : k}"></i>`).join("")}</span></button>`);
    }
    const list = selDay ? ev.filter(e => e.date === selDay) : ev;
    return { title: "Календарь", key: "calendar", html: `
      <div class="monthsw"><button class="btn small" id="cal-prev" aria-label="Предыдущий месяц">${ic("left")}</button><b>${ymLabel(ym)}</b><button class="btn small" id="cal-next" aria-label="Следующий месяц">${ic("chev")}</button></div>
      <section class="block cal">
        <div class="wd">${["Пн", "Вт", "Ср", "Чт", "Пт", "Сб", "Вс"].map(x => `<span>${x}</span>`).join("")}</div>
        <div class="grid">${cells.join("")}</div>
        <div class="legend-cal"><span><i class="k-plan"></i>срок изделия</span><span><i class="k-late"></i>срок прошёл</span><span><i class="k-money"></i>оплата клиента</span><span><i class="k-loan"></i>кредит</span></div>
      </section>
      <p class="sect-title">${selDay ? fdate(selDay) : "Все события месяца"}${selDay ? ` <button class="btn small" id="cal-all" style="margin-left:8px">Весь месяц</button>` : ""}</p>
      <div class="list">${list.map(e => `<button class="oprow" ${e.act}><span class="ico ${e.kind === "plan" ? "" : "money"}">${ic(e.kind === "plan" ? "box" : e.kind === "loan" ? "bank" : "coins")}</span><span class="l"><b>${esc(e.title)}</b><small ${e.late ? 'style="color:var(--red)"' : ""}>${fdate(e.date)}${e.late ? ", просрочено" : ""} · ${esc(e.sub)}</small></span>${ic("chev", "chev")}</button>`).join("") || `<div class="empty">${selDay ? "В этот день событий нет." : "В этом месяце событий нет."}</div>`}</div>`,
      after: l => {
        $("#cal-prev", l).onclick = () => { ym = Core.shiftYm(ym, -1); selDay = ""; renderSheet(); };
        $("#cal-next", l).onclick = () => { ym = Core.shiftYm(ym, 1); selDay = ""; renderSheet(); };
        const all = $("#cal-all", l); if (all) all.onclick = () => { selDay = ""; renderSheet(); };
        l.querySelectorAll("[data-day]").forEach(b => (b.onclick = () => { selDay = selDay === b.dataset.day ? "" : b.dataset.day; renderSheet(); }));
      } };
  };
}

