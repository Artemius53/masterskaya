  D.C.forEach(dc => { debt += dc.debt; expected += dc.expected; overdue += dc.overdue; });
  return `
    <div class="stats">
      ${stat(rub(debt), "должны по заказам", "coins", "v-money", "", "money-ic")}
      ${stat(rub(expected), `ждём оплат${overdue ? `, <span class="v-red" style="display:inline">просрочено ${rub(overdue)}</span>` : ""}`, "clock", overdue ? "v-red" : "")}
    </div>
    ${searchBox("q-clients", "cq", "Поиск: имя, телефон, пункт выдачи")}
    <div class="list" id="list-cq">${clientList()}</div>`;
}
function clientList() {
  const all = [...D.C.values()];
  const q = view.cq.toLowerCase();
  let list = q ? all.filter(dc => [dc.client.name, dc.client.phone, dc.client.pickup].join(" ").toLowerCase().includes(q)) : all;
  list.sort((a, b) => a.client.name.localeCompare(b.client.name, "ru"));
