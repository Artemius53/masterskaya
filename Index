  /* Возвращает массив листов [{name, rows:[[...]]}] — независимо от библиотеки Excel */
  function toSheets(state) {
    const D = derive(state);
    D.B = budget(state, D, today().slice(0, 7));
    const sheets = [];
    const counts = TABLES.map(t => [SCHEMA[t].sheet, state[t].length]);
    sheets.push({ name: "Служебный", rows: [
      ["Параметр", "Значение"],
      ["Версия формата", FORMAT_VERSION],
      ["Выгружено", nowIso()],
      ...counts.map(([n, c]) => ["Строк на листе «" + n + "»", c]),
      ["Как править", "Столбцы ID и служебные поля не меняйте. Новую строку добавляйте с пустым ID — приложение присвоит его само. Столбцы «расчёт: …» при загрузке игнорируются и пересчитываются. Удалять строки можно, но надёжнее ставить «да» в столбце «Удалено»."]
    ]});
    TABLES.forEach(t => {
      const sc = SCHEMA[t];
      const base = sc.cols.map(c => c[1]);
      const calcHeads = t === "log" ? [] : Object.keys(calcTemplate(t));
      const rows = [base.concat(calcHeads)];
      const ordered = t === "log" ? state.log.slice().sort((a, b) => (a.at < b.at ? 1 : -1)) : state[t];
      ordered.forEach(r => {
        const calc = t === "log" ? {} : calcColumns(t, r, D, state);
        rows.push(sc.cols.map(c => outVal(r[c[0]], c[2])).concat(calcHeads.map(h => calc[h] ?? "")));
      });

      sheets.push({ name: sc.sheet, rows });
    });
    const st = state.settings;
    sheets.push({ name: "Настройки", rows: [
      ["Параметр", "Значение"],
      ["Ставка часа, ₽", st.hourRate],
      ["Напоминать о копии через, дн", st.remindDays],
      ["Следующий номер заказа", st.nextOrderNo],
      ["Последняя выгрузка", st.lastExportAt || ""],
      ["Серии (через ;)", st.series.join("; ")],
      ["Способы оплаты (через ;)", st.methods.join("; ")],
      ["Налог, %", st.taxPct],
      ["База налога (cash — поступления, revenue — выручка)", st.taxBase],
      ["Категории расходов (через ;)", st.expenseCats.join("; ")],
      ["Категории доходов (через ;)", st.incomeCats.join("; ")]
    ]});
    return sheets;
  }
  function calcTemplate(t) {
    const fake = { items: {}, clients: {}, orders: {}, lines: {}, payments: {}, plans: {}, subs: {} }[t];
    const keys = {
      items: ["себестоимость, ₽", "маржа, ₽", "осталось сделать, шт", "свободно готовых, шт", "в резерве, шт", "продано, шт", "не хватает под заказы, шт"],
      clients: ["всего оплатил, ₽", "долг, ₽", "ожидается, ₽"],
      orders: ["клиент", "сумма без скидки, ₽", "итого, ₽", "оплачено, ₽", "остаток к оплате, ₽", "маржа, ₽"],
      batches: ["изделие"], lines: ["изделие"], payments: ["клиент", "номер заказа", "счёт"], plans: ["клиент", "номер заказа"], subs: [],
      accounts: ["остаток, ₽"], ops: ["счёт", "счёт зачисления", "кредит"], loans: ["остаток долга, ₽", "следующий платёж"]
    }[t] || [];
    void fake;
    const o = {}; keys.forEach(k => (o[CALC + k] = "")); return o;
  }
  function outVal(v, type) {
    if (type === "bool") return v ? "да" : "";
    if (v === undefined || v === null) return "";
    return v;
  }

  /* --- Импорт: принимает {имяЛиста: [[...строки]]}, возвращает {state, errors, warnings, counts} --- */
  function fromSheets(book) {
    const errors = [], warnings = [];
    const st = emptyState();
    if (!book["Служебный"]) warnings.push("Нет листа «Служебный» — файл, возможно, выгружен не из приложения.");
    else {
      const ver = (book["Служебный"].find(r => r[0] === "Версия формата") || [])[1];
      if (ver && num(ver) > FORMAT_VERSION) errors.push(`Файл новее приложения (версия формата ${ver}).`);
    }
    TABLES.forEach(t => {
      const sc = SCHEMA[t];
      const rows = book[sc.sheet] || (sc.aliases || []).map(a => book[a]).find(Boolean);
      if (!rows) { if (t !== "log") warnings.push(`Нет листа «${sc.sheet}» — он будет пустым.`); return; }
      const head = (rows[0] || []).map(h => String(h ?? "").trim());
      const idx = {};
      sc.cols.forEach(c => { idx[c[0]] = head.indexOf(c[1]); if (idx[c[0]] < 0 && c[4]) idx[c[0]] = head.findIndex(h => c[4].includes(h)); });
      sc.cols.forEach(c => { if (c[3] && idx[c[0]] < 0) errors.push(`Лист «${sc.sheet}»: нет столбца «${c[1]}».`); });
      const seen = new Set();
      rows.slice(1).forEach((r, i) => {
        if (!r || r.every(v => v === "" || v === null || v === undefined)) return;
        const rowNo = i + 2;
        const rec = {};
        sc.cols.forEach(c => {
          const raw = idx[c[0]] >= 0 ? r[idx[c[0]]] : "";
          rec[c[0]] = inVal(raw, c[2]);
        });
        if (t === "items") {
          const legacy = { planned: "Запланировано, шт", wip: "В работе, шт", planDate: "Плановая дата", planFor: "Цель плана" };
          Object.entries(legacy).forEach(([key, h]) => { const ix = head.indexOf(h); if (ix >= 0) rec[key] = inVal(r[ix], key === "planDate" ? "date" : key === "planFor" ? "text" : "int"); });
        }
        if (!rec.id) rec.id = uid();
        if (seen.has(rec.id)) { errors.push(`Лист «${sc.sheet}», строка ${rowNo}: ID ${rec.id} повторяется.`); return; }
        seen.add(rec.id);
        if (t !== "log") {
          if (!rec.createdAt) rec.createdAt = nowIso();
          if (!rec.updatedAt) rec.updatedAt = rec.createdAt;
        }
        if (!rec.deleted) {
          sc.cols.forEach(c => {
            if (c[3] && (rec[c[0]] === "" || rec[c[0]] === null)) errors.push(`Лист «${sc.sheet}», строка ${rowNo}: не заполнено «${c[1]}».`);
          });
        }
        rec._row = rowNo;
        st[t].push(rec);
      });
    });

    // Ссылки
    const ids = t => new Set(st[t].map(r => r.id));
    const itemIds = ids("items"), clientIds = ids("clients"), orderIds = ids("orders");
    const seriesFromItems = new Set(st.items.map(i => i.series).filter(Boolean));
    const ref = (t, rec, key, set, label) => {
      if (rec.deleted) return;
      if (rec[key] && !set.has(rec[key])) errors.push(`Лист «${SCHEMA[t].sheet}», строка ${rec._row}: ${label} ${rec[key]} не найден.`);
    };
    st.orders.forEach(r => {
      ref("orders", r, "clientId", clientIds, "клиент");
      if (r.status && !STATUSES.includes(r.status)) errors.push(`Лист «Заказы», строка ${r._row}: неизвестный статус «${r.status}». Допустимо: ${STATUSES.join(", ")}.`);
      if (!r.status) r.status = "Новый";
    });
    st.batches.forEach(r => { ref("batches", r, "itemId", itemIds, "изделие"); if (!r.deleted && r.qty <= 0) errors.push(`Лист «Тиражи», строка ${r._row}: тираж должен быть больше нуля.`); if (!r.deleted && r.done > r.qty) errors.push(`Лист «Тиражи», строка ${r._row}: готово больше тиража.`); });
    st.lines.forEach(r => { ref("lines", r, "orderId", orderIds, "заказ"); ref("lines", r, "itemId", itemIds, "изделие"); if (!r.deleted && r.qty <= 0) errors.push(`Лист «Строки заказов», строка ${r._row}: количество должно быть больше нуля.`); });
    st.payments.forEach(r => {
      ref("payments", r, "clientId", clientIds, "клиент"); ref("payments", r, "orderId", orderIds, "заказ");
      if (!r.kind) r.kind = "Оплата";
      if (!["Оплата", "Возврат"].includes(r.kind)) errors.push(`Лист «Оплаты факт», строка ${r._row}: вид должен быть «Оплата» или «Возврат».`);
    });
    st.plans.forEach(r => { ref("plans", r, "clientId", clientIds, "клиент"); ref("plans", r, "orderId", orderIds, "заказ"); });
    const accountIds = ids("accounts"), loanIds = ids("loans");
    // Старые файлы (версия 1): столбец «Способ» вместо счёта
    const payRows = book[SCHEMA.payments.sheet];
    if (payRows && payRows[0]) {
      const mi = payRows[0].map(h => String(h ?? "").trim()).indexOf("Способ");
      if (mi >= 0) st.payments.forEach(p => { if (!p.accountId) p.method = String((payRows[p._row - 1] || [])[mi] ?? "").trim(); });
    }
    st.payments.forEach(r => { if (r.accountId) ref("payments", r, "accountId", accountIds, "счёт"); });
    st.ops.forEach(r => {
      if (r.deleted) return;
      if (!OP_KINDS.includes(r.kind)) errors.push(`Лист «Операции», строка ${r._row}: неизвестный вид «${r.kind}». Допустимо: ${OP_KINDS.join(", ")}.`);
      if (!r.accountId) errors.push(`Лист «Операции», строка ${r._row}: не указан ID счёта.`);
      ref("ops", r, "accountId", accountIds, "счёт");
      if (r.kind === "Перевод") { if (!r.toAccountId) errors.push(`Лист «Операции», строка ${r._row}: у перевода не указан счёт зачисления.`); ref("ops", r, "toAccountId", accountIds, "счёт"); }
      if (r.kind === "Платёж по кредиту" || r.kind === "Кредит получен") { if (!r.loanId) errors.push(`Лист «Операции», строка ${r._row}: не указан ID кредита.`); ref("ops", r, "loanId", loanIds, "кредит"); }
      if (r.kind === "Платёж по кредиту" && !r.principal && !r.interest) r.principal = r.amount;
    });
