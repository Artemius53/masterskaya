/* --- Счета --- */
function accountSheet(id) {
  return () => {
    const a = find("accounts", id); if (!a) return null;
    const B = Core.budget(S, D, view.ym);
    const x = B.A.get(id);
    const moves = [];
    Core.live(S.payments).forEach(p => { if (p.accountId === id) moves.push({ date: p.date, html: payOpRow(p) }); });
    Core.live(S.ops).forEach(op => { if (op.accountId === id || op.toAccountId === id) moves.push({ date: op.date, html: opRow(op) }); });
    moves.sort((p, q) => (p.date < q.date ? 1 : -1));
    return { title: a.name, key: "acc" + id, html: `
      <section class="block"><div class="kv accent"><span>Остаток</span><span class="num">${rub(x ? x.balance : 0)}</span></div>
        <div class="kv"><span>Начальный остаток</span><span class="num">${rub(a.opening)}${a.openingDate ? " на " + fdate(a.openingDate) : ""}</span></div></section>
      <p class="sect-title">Последние движения</p>
      <div class="list">${moves.slice(0, 30).map(m => m.html).join("") || `<div class="empty">Движений нет.</div>`}</div>
      <div class="btns g2 bottom"><button class="btn outline" data-a="account-form" data-id="${id}">${ic("pencil")}Изменить</button><button class="btn danger" id="acc-del">${ic("trash")}Удалить</button></div>`,
      after: l => {
        $("#acc-del", l).onclick = () => {
          if (moves.length) { toast("По счёту есть движения — удалить нельзя."); return; }
          confirmSheet("Удалить счёт?", esc(a.name), "Удалить", () => { a.deleted = true; touch(a); log("Бюджет", id, `Удалён счёт «${a.name}»`); sheets.length = 0; commit(); }, true);
        };
      } };
  };
}
